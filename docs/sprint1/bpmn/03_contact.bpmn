<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="cnt_defs" targetNamespace="http://kpi.ua/tzyapz/shopline" exporter="Command C generator" exporterVersion="1.0">
<bpmn:collaboration id="cnt_collab">
<bpmn:participant id="P_buyer" name="Покупець" processRef="P_buyer_proc" />
<bpmn:participant id="P_shop" name="ШопЛайн" processRef="P_shop_proc" />
<bpmn:messageFlow id="mf1" name="Контактна форма" sourceRef="b_send" targetRef="s_start" />
<bpmn:messageFlow id="mf2" name="Автовідповідь" sourceRef="s_reg" targetRef="b_c_auto" />
<bpmn:messageFlow id="mf3" name="Відповідь" sourceRef="s_answer" targetRef="b_c_ans" />
<bpmn:messageFlow id="mf4" name="Уточнення" sourceRef="b_clar" targetRef="s_c_clar" />
</bpmn:collaboration>
<bpmn:process id="P_buyer_proc" isExecutable="false">
<bpmn:dataObject id="do_req_do" />
<bpmn:dataObjectReference id="do_req" name="Звернення" dataObjectRef="do_req_do" />
<bpmn:startEvent id="b_start" name="Виникло питання до магазину"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:sendTask id="b_send" name="Надіслати контактну форму"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:dataOutputAssociation id="b_send_do_req_out"><bpmn:targetRef>do_req</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="b_c_auto" name="Отримано автовідповідь"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing><bpmn:messageEventDefinition id="cnt_x1" /></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="b_merge" name=""><bpmn:incoming>f3</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:intermediateCatchEvent id="b_c_ans" name="Отримано відповідь"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:messageEventDefinition id="cnt_x2" /></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="b_gw" name="Потрібне уточнення?" default="f7"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="b_clar" name="Надіслати уточнення"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="b_end" name="Питання вирішено"><bpmn:incoming>f7</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="b_start" targetRef="b_send"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f2" sourceRef="b_send" targetRef="b_c_auto"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f3" sourceRef="b_c_auto" targetRef="b_merge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f4" sourceRef="b_merge" targetRef="b_c_ans"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f5" sourceRef="b_c_ans" targetRef="b_gw"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f6" name="так" sourceRef="b_gw" targetRef="b_clar"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">так</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f7" name="ні" sourceRef="b_gw" targetRef="b_end"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f8" sourceRef="b_clar" targetRef="b_merge"></bpmn:sequenceFlow>
</bpmn:process>
<bpmn:process id="P_shop_proc" isExecutable="false">
<bpmn:laneSet id="P_shop_ls">
<bpmn:lane id="L_site" name="Сайт (система)">
<bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_reg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_remind</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_end_rem</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_answer</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_evgw</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_c_clar</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_timer</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_close</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_end</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_mgr" name="Менеджер магазину">
<bpmn:flowNodeRef>m_merge</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_class</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gw</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_ans</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_timer</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_merge2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_adm" name="Адміністратор">
<bpmn:flowNodeRef>a_ans</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:dataStoreReference id="ds_req" name="База звернень" />
<bpmn:startEvent id="s_start" name="Отримано звернення"><bpmn:outgoing>g1</bpmn:outgoing><bpmn:messageEventDefinition id="cnt_x3" /></bpmn:startEvent>
<bpmn:sendTask id="s_reg" name="Зареєструвати звернення і надіслати автовідповідь"><bpmn:incoming>g1</bpmn:incoming><bpmn:outgoing>g2</bpmn:outgoing><bpmn:dataOutputAssociation id="s_reg_ds_req_out"><bpmn:targetRef>ds_req</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:sendTask>
<bpmn:exclusiveGateway id="m_merge" name=""><bpmn:incoming>g2</bpmn:incoming><bpmn:incoming>g17</bpmn:incoming><bpmn:outgoing>g3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="m_class" name="Класифікувати звернення за темою"><bpmn:incoming>g3</bpmn:incoming><bpmn:outgoing>g4</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m_gw" name="Тип звернення?" default="g5"><bpmn:incoming>g4</bpmn:incoming><bpmn:outgoing>g5</bpmn:outgoing><bpmn:outgoing>g6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="m_ans" name="Підготувати відповідь"><bpmn:incoming>g5</bpmn:incoming><bpmn:outgoing>g9</bpmn:outgoing></bpmn:task>
<bpmn:boundaryEvent id="m_timer" name="24 год без реакції" attachedToRef="m_ans" cancelActivity="false"><bpmn:outgoing>g7</bpmn:outgoing><bpmn:timerEventDefinition id="cnt_x4"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:task id="s_remind" name="Надіслати нагадування виконавцю"><bpmn:incoming>g7</bpmn:incoming><bpmn:outgoing>g8</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="s_end_rem" name="Нагадування надіслано"><bpmn:incoming>g8</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="a_ans" name="Підготувати відповідь на технічне питання"><bpmn:incoming>g6</bpmn:incoming><bpmn:outgoing>g10</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m_merge2" name=""><bpmn:incoming>g9</bpmn:incoming><bpmn:incoming>g10</bpmn:incoming><bpmn:outgoing>g11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="s_answer" name="Надіслати відповідь у кабінет і на email"><bpmn:incoming>g11</bpmn:incoming><bpmn:outgoing>g12</bpmn:outgoing></bpmn:sendTask>
<bpmn:eventBasedGateway id="s_evgw" name="Що настане раніше?"><bpmn:incoming>g12</bpmn:incoming><bpmn:outgoing>g13</bpmn:outgoing><bpmn:outgoing>g14</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="s_c_clar" name="Отримано уточнення"><bpmn:incoming>g13</bpmn:incoming><bpmn:outgoing>g17</bpmn:outgoing><bpmn:messageEventDefinition id="cnt_x5" /></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="s_timer" name="Минуло 3 дні"><bpmn:incoming>g14</bpmn:incoming><bpmn:outgoing>g15</bpmn:outgoing><bpmn:timerEventDefinition id="cnt_x6"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:task id="s_close" name="Закрити звернення"><bpmn:incoming>g15</bpmn:incoming><bpmn:outgoing>g16</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="s_end" name="Звернення закрито"><bpmn:incoming>g16</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="g1" sourceRef="s_start" targetRef="s_reg"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g2" sourceRef="s_reg" targetRef="m_merge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g3" sourceRef="m_merge" targetRef="m_class"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g4" sourceRef="m_class" targetRef="m_gw"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g5" name="не технічна" sourceRef="m_gw" targetRef="m_ans"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g6" name="технічна проблема" sourceRef="m_gw" targetRef="a_ans"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">технічна проблема</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g7" sourceRef="m_timer" targetRef="s_remind"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g8" sourceRef="s_remind" targetRef="s_end_rem"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g9" sourceRef="m_ans" targetRef="m_merge2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g10" sourceRef="a_ans" targetRef="m_merge2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g11" sourceRef="m_merge2" targetRef="s_answer"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g12" sourceRef="s_answer" targetRef="s_evgw"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g13" sourceRef="s_evgw" targetRef="s_c_clar"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g14" sourceRef="s_evgw" targetRef="s_timer"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g15" sourceRef="s_timer" targetRef="s_close"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g16" sourceRef="s_close" targetRef="s_end"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g17" sourceRef="s_c_clar" targetRef="m_merge"></bpmn:sequenceFlow>
<bpmn:textAnnotation id="n1"><bpmn:text>Тема з форми: Customer service, Webmaster, Return, Payments, Warranty, Status of my order</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="n1_as" sourceRef="m_class" targetRef="n1" />
<bpmn:textAnnotation id="n2"><bpmn:text>Покупець може уточнити питання протягом 3 днів</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="n2_as" sourceRef="s_evgw" targetRef="n2" />
</bpmn:process>
