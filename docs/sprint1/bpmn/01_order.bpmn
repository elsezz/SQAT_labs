<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="order_defs" targetNamespace="http://kpi.ua/tzyapz/shopline" exporter="Command C generator" exporterVersion="1.0">
<bpmn:collaboration id="order_collab">
<bpmn:participant id="P_buyer" name="Покупець" processRef="P_buyer_proc" />
<bpmn:participant id="P_shop" name="ШопЛайн" processRef="P_shop_proc" />
<bpmn:participant id="P_pay" name="Платіжний шлюз" />
<bpmn:participant id="P_dlv" name="Служба доставки" />
<bpmn:messageFlow id="mf1" name="Замовлення" sourceRef="b_confirm" targetRef="s_start" />
<bpmn:messageFlow id="mf2" name="Запит на оплату" sourceRef="s_req" targetRef="P_pay" />
<bpmn:messageFlow id="mf3" name="Результат оплати" sourceRef="P_pay" targetRef="s_c_resp" />
<bpmn:messageFlow id="mf4" name="Скасування" sourceRef="s_cancel" targetRef="b_c_no" />
<bpmn:messageFlow id="mf5" name="Відмова в оплаті" sourceRef="s_decline" targetRef="b_c_no" />
<bpmn:messageFlow id="mf6" name="Підтвердження" sourceRef="s_confirm" targetRef="b_c_ok" />
<bpmn:messageFlow id="mf7" name="Замовлення на доставку" sourceRef="m_hand" targetRef="P_dlv" />
<bpmn:messageFlow id="mf8" name="Статус «Доставлено»" sourceRef="P_dlv" targetRef="m_c_deliv" />
<bpmn:messageFlow id="mf9" name="Посилка" sourceRef="P_dlv" targetRef="b_c_parcel" />
</bpmn:collaboration>
<bpmn:process id="P_buyer_proc" isExecutable="false">
<bpmn:dataObject id="do_cart_do" />
<bpmn:dataObjectReference id="do_cart" name="Кошик" dataObjectRef="do_cart_do" />
<bpmn:startEvent id="b_start" name="Кошик сформовано"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="b_checkout" name="Натиснути «Оформити замовлення»"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:dataInputAssociation id="b_checkout_do_cart_in"><bpmn:sourceRef>do_cart</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:task>
<bpmn:exclusiveGateway id="b_gw_login" name="Покупець увійшов у кабінет?" default="f4"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing><bpmn:outgoing>f4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="b_login" name="Увійти або зареєструватися"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="b_merge1" name=""><bpmn:incoming>f3</bpmn:incoming><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="b_address" name="Вказати адресу доставки"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="b_gw_pay" name="Спосіб оплати?" default="f9"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="b_card" name="Ввести дані картки"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task>
<bpmn:task id="b_offline" name="Обрати переказ або оплату при отриманні"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="b_merge2" name=""><bpmn:incoming>f10</bpmn:incoming><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="b_confirm" name="Підтвердити замовлення"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:sendTask>
<bpmn:eventBasedGateway id="b_evgw" name="Яка відповідь магазину?"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing><bpmn:outgoing>f15</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="b_c_ok" name="Отримано підтвердження з номером"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:messageEventDefinition id="order_x1" /></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="b_c_parcel" name="Отримано посилку"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing><bpmn:messageEventDefinition id="order_x2" /></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="b_end_ok" name="Замовлення отримано"><bpmn:incoming>f17</bpmn:incoming></bpmn:endEvent>
<bpmn:intermediateCatchEvent id="b_c_no" name="Отримано відмову"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing><bpmn:messageEventDefinition id="order_x3" /></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="b_end_no" name="Замовлення не оформлено"><bpmn:incoming>f18</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="b_start" targetRef="b_checkout"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f2" sourceRef="b_checkout" targetRef="b_gw_login"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f3" name="так" sourceRef="b_gw_login" targetRef="b_merge1"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f4" name="ні" sourceRef="b_gw_login" targetRef="b_login"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f5" sourceRef="b_login" targetRef="b_merge1"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f6" sourceRef="b_merge1" targetRef="b_address"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f7" sourceRef="b_address" targetRef="b_gw_pay"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f8" name="картка онлайн" sourceRef="b_gw_pay" targetRef="b_card"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">картка онлайн</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f9" name="інший спосіб" sourceRef="b_gw_pay" targetRef="b_offline"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f10" sourceRef="b_card" targetRef="b_merge2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f11" sourceRef="b_offline" targetRef="b_merge2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f12" sourceRef="b_merge2" targetRef="b_confirm"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f13" sourceRef="b_confirm" targetRef="b_evgw"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f14" sourceRef="b_evgw" targetRef="b_c_ok"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f15" sourceRef="b_evgw" targetRef="b_c_no"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f16" sourceRef="b_c_ok" targetRef="b_c_parcel"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f17" sourceRef="b_c_parcel" targetRef="b_end_ok"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f18" sourceRef="b_c_no" targetRef="b_end_no"></bpmn:sequenceFlow>
<bpmn:textAnnotation id="n1"><bpmn:text>Способи оплати — як у поточній версії продукту (F-110)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="n1_as" sourceRef="b_gw_pay" targetRef="n1" />
</bpmn:process>
<bpmn:process id="P_shop_proc" isExecutable="false">
<bpmn:laneSet id="P_shop_ls">
<bpmn:lane id="L_site" name="Сайт (система)">
<bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_gw_online</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_req</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_evgw</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_c_resp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_timer</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_cancel</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_end_cancel</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_gw_paid</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_decline</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_end_decl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_merge</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_create</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_and1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_confirm</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_mgr" name="Менеджер магазину">
<bpmn:flowNodeRef>m_pick</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_and2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_hand</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_c_deliv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_end</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:dataObject id="do_invoice_do" />
<bpmn:dataObjectReference id="do_invoice" name="Рахунок-інвойс" dataObjectRef="do_invoice_do" />
<bpmn:startEvent id="s_start" name="Отримано замовлення"><bpmn:outgoing>g1</bpmn:outgoing><bpmn:messageEventDefinition id="order_x4" /></bpmn:startEvent>
<bpmn:exclusiveGateway id="s_gw_online" name="Оплата онлайн?" default="g3"><bpmn:incoming>g1</bpmn:incoming><bpmn:outgoing>g2</bpmn:outgoing><bpmn:outgoing>g3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="s_req" name="Надіслати запит на оплату"><bpmn:incoming>g2</bpmn:incoming><bpmn:outgoing>g4</bpmn:outgoing></bpmn:sendTask>
<bpmn:eventBasedGateway id="s_evgw" name="Що настане раніше?"><bpmn:incoming>g4</bpmn:incoming><bpmn:outgoing>g5</bpmn:outgoing><bpmn:outgoing>g6</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="s_c_resp" name="Отримано відповідь шлюзу"><bpmn:incoming>g5</bpmn:incoming><bpmn:outgoing>g9</bpmn:outgoing><bpmn:messageEventDefinition id="order_x5" /></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="s_timer" name="Минуло 24 години"><bpmn:incoming>g6</bpmn:incoming><bpmn:outgoing>g7</bpmn:outgoing><bpmn:timerEventDefinition id="order_x6"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:sendTask id="s_cancel" name="Скасувати замовлення"><bpmn:incoming>g7</bpmn:incoming><bpmn:outgoing>g8</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="s_end_cancel" name="Покупець відмовився"><bpmn:incoming>g8</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="s_gw_paid" name="Оплату підтверджено?" default="g11"><bpmn:incoming>g9</bpmn:incoming><bpmn:outgoing>g10</bpmn:outgoing><bpmn:outgoing>g11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="s_decline" name="Повідомити про відхилення оплати"><bpmn:incoming>g11</bpmn:incoming><bpmn:outgoing>g12</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="s_end_decl" name="Оплату відхилено"><bpmn:incoming>g12</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="s_merge" name=""><bpmn:incoming>g3</bpmn:incoming><bpmn:incoming>g10</bpmn:incoming><bpmn:outgoing>g13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="s_create" name="Створити замовлення і рахунок-інвойс"><bpmn:incoming>g13</bpmn:incoming><bpmn:outgoing>g14</bpmn:outgoing><bpmn:dataOutputAssociation id="s_create_do_invoice_out"><bpmn:targetRef>do_invoice</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
<bpmn:parallelGateway id="s_and1" name=""><bpmn:incoming>g14</bpmn:incoming><bpmn:outgoing>g15</bpmn:outgoing><bpmn:outgoing>g16</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:sendTask id="s_confirm" name="Надіслати підтвердження з номером"><bpmn:incoming>g15</bpmn:incoming><bpmn:outgoing>g17</bpmn:outgoing></bpmn:sendTask>
<bpmn:subProcess id="m_pick" name="Укомплектувати замовлення"><bpmn:incoming>g16</bpmn:incoming><bpmn:outgoing>g18</bpmn:outgoing>
<bpmn:startEvent id="m_pick_i0" name="Замовлення передано на склад"><bpmn:outgoing>m_pick_f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="m_pick_i1" name="Зібрати товари за переліком"><bpmn:incoming>m_pick_f1</bpmn:incoming><bpmn:outgoing>m_pick_f2</bpmn:outgoing></bpmn:task>
<bpmn:sequenceFlow id="m_pick_f1" sourceRef="m_pick_i0" targetRef="m_pick_i1" />
<bpmn:task id="m_pick_i2" name="Упакувати і наклеїти етикетку"><bpmn:incoming>m_pick_f2</bpmn:incoming><bpmn:outgoing>m_pick_f3</bpmn:outgoing></bpmn:task>
<bpmn:sequenceFlow id="m_pick_f2" sourceRef="m_pick_i1" targetRef="m_pick_i2" />
<bpmn:endEvent id="m_pick_i3" name="Замовлення укомплектовано"><bpmn:incoming>m_pick_f3</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="m_pick_f3" sourceRef="m_pick_i2" targetRef="m_pick_i3" />
</bpmn:subProcess>
<bpmn:parallelGateway id="m_and2" name=""><bpmn:incoming>g17</bpmn:incoming><bpmn:incoming>g18</bpmn:incoming><bpmn:outgoing>g19</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:sendTask id="m_hand" name="Передати замовлення службі доставки"><bpmn:incoming>g19</bpmn:incoming><bpmn:outgoing>g20</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="m_c_deliv" name="Отримано статус доставки"><bpmn:incoming>g20</bpmn:incoming><bpmn:outgoing>g21</bpmn:outgoing><bpmn:messageEventDefinition id="order_x7" /></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="m_end" name="Доставлено"><bpmn:incoming>g21</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="g1" sourceRef="s_start" targetRef="s_gw_online"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g2" name="так" sourceRef="s_gw_online" targetRef="s_req"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">так</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g3" name="ні" sourceRef="s_gw_online" targetRef="s_merge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g4" sourceRef="s_req" targetRef="s_evgw"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g5" sourceRef="s_evgw" targetRef="s_c_resp"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g6" sourceRef="s_evgw" targetRef="s_timer"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g7" sourceRef="s_timer" targetRef="s_cancel"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g8" sourceRef="s_cancel" targetRef="s_end_cancel"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g9" sourceRef="s_c_resp" targetRef="s_gw_paid"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g10" name="так" sourceRef="s_gw_paid" targetRef="s_merge"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">так</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g11" name="ні" sourceRef="s_gw_paid" targetRef="s_decline"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g12" sourceRef="s_decline" targetRef="s_end_decl"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g13" sourceRef="s_merge" targetRef="s_create"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g14" sourceRef="s_create" targetRef="s_and1"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g15" sourceRef="s_and1" targetRef="s_confirm"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g16" sourceRef="s_and1" targetRef="m_pick"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g17" sourceRef="s_confirm" targetRef="m_and2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g18" sourceRef="m_pick" targetRef="m_and2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g19" sourceRef="m_and2" targetRef="m_hand"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g20" sourceRef="m_hand" targetRef="m_c_deliv"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g21" sourceRef="m_c_deliv" targetRef="m_end"></bpmn:sequenceFlow>
<bpmn:textAnnotation id="n2"><bpmn:text>Оплата онлайн не надійшла протягом 24 год</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="n2_as" sourceRef="s_timer" targetRef="n2" />
</bpmn:process>
<bpmndi:BPMNDiagram id="order_dia" name="01 Оформлення замовлення"><bpmndi:BPMNPlane id="order_plane" bpmnElement="order_collab">
<bpmndi:BPMNShape id="P_buyer_di" bpmnElement="P_buyer" isHorizontal="true"><dc:Bounds x="100" y="0" width="1920" height="260" /></bpmndi:BPMNShape>
