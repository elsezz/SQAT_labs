<bpmndi:BPMNShape id="L_mgr_di" bpmnElement="L_mgr" isHorizontal="true"><dc:Bounds x="130" y="690" width="1890" height="200" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="P_pay_di" bpmnElement="P_pay" isHorizontal="true"><dc:Bounds x="100" y="950" width="1920" height="60" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="P_dlv_di" bpmnElement="P_dlv" isHorizontal="true"><dc:Bounds x="100" y="1050" width="1920" height="60" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="b_start_di" bpmnElement="b_start"><dc:Bounds x="162" y="112" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="125" y="153" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="b_checkout_di" bpmnElement="b_checkout"><dc:Bounds x="230" y="90" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="b_gw_login_di" bpmnElement="b_gw_login" isMarkerVisible="true"><dc:Bounds x="395" y="105" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="355" y="60" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="b_login_di" bpmnElement="b_login"><dc:Bounds x="480" y="165" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="b_merge1_di" bpmnElement="b_merge1" isMarkerVisible="true"><dc:Bounds x="635" y="105" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="605" y="160" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="b_address_di" bpmnElement="b_address"><dc:Bounds x="720" y="90" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="b_gw_pay_di" bpmnElement="b_gw_pay" isMarkerVisible="true"><dc:Bounds x="885" y="105" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="860" y="20" width="100" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="b_card_di" bpmnElement="b_card"><dc:Bounds x="970" y="15" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="b_offline_di" bpmnElement="b_offline"><dc:Bounds x="970" y="165" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="b_merge2_di" bpmnElement="b_merge2" isMarkerVisible="true"><dc:Bounds x="1125" y="105" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1095" y="160" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
