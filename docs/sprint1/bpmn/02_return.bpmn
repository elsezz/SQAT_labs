<bpmndi:BPMNShape id="s_join_di" bpmnElement="s_join"><dc:Bounds x="1615" y="535" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1585" y="590" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
