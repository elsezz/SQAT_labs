<bpmndi:BPMNShape id="s_end_full_di" bpmnElement="s_end_full"><dc:Bounds x="1982" y="542" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2023" y="540" width="70" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="s_end_part_di" bpmnElement="s_end_part"><dc:Bounds x="1982" y="612" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2023" y="610" width="80" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
