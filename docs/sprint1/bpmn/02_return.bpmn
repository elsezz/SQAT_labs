<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="ret_defs" targetNamespace="http://kpi.ua/tzyapz/shopline" exporter="Command C generator" exporterVersion="1.0">
<bpmn:collaboration id="ret_collab">
<bpmn:participant id="P_dlv" name="Служба доставки" />
<bpmn:participant id="P_buyer" name="Покупець" processRef="P_buyer_proc" />
<bpmn:participant id="P_shop" name="ШопЛайн" processRef="P_shop_proc" />
<bpmn:messageFlow id="mf1" name="Заявка (номер замовлення, причина)" sourceRef="b_apply" targetRef="s_start" />
<bpmn:messageFlow id="mf2" name="Відмова" sourceRef="m_refuse" targetRef="b_c_no" />
<bpmn:messageFlow id="mf3" name="Дозвіл на повернення" sourceRef="m_allow" targetRef="b_c_ok" />
<bpmn:messageFlow id="mf4" name="Посилка з товаром" sourceRef="b_send" targetRef="P_dlv" />
<bpmn:messageFlow id="mf5" name="Товар" sourceRef="P_dlv" targetRef="w_c_goods" />
<bpmn:messageFlow id="mf6" name="Повне повернення" sourceRef="s_notify_full" targetRef="b_c_res" />
<bpmn:messageFlow id="mf7" name="Часткове повернення" sourceRef="s_notify_part" targetRef="b_c_res" />
</bpmn:collaboration>
<bpmn:process id="P_buyer_proc" isExecutable="false">
<bpmn:dataObject id="do_claim_do" />
<bpmn:dataObjectReference id="do_claim" name="Заявка на повернення" dataObjectRef="do_claim_do" />
<bpmn:startEvent id="b_start" name="Потрібно повернути товар"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:sendTask id="b_apply" name="Подати заявку на повернення"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:dataOutputAssociation id="b_apply_do_claim_out"><bpmn:targetRef>do_claim</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:sendTask>
<bpmn:eventBasedGateway id="b_evgw" name="Яке рішення магазину?"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing><bpmn:outgoing>f4</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="b_c_ok" name="Отримано дозвіл на повернення"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:messageEventDefinition id="ret_x1" /></bpmn:intermediateCatchEvent>
<bpmn:sendTask id="b_send" name="Надіслати товар службою доставки"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="b_c_res" name="Отримано результат повернення"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:messageEventDefinition id="ret_x2" /></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="b_end_ok" name="Повернення завершено"><bpmn:incoming>f7</bpmn:incoming></bpmn:endEvent>
<bpmn:intermediateCatchEvent id="b_c_no" name="Отримано відмову"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:messageEventDefinition id="ret_x3" /></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="b_end_no" name="У поверненні відмовлено"><bpmn:incoming>f8</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="b_start" targetRef="b_apply"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f2" sourceRef="b_apply" targetRef="b_evgw"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f3" sourceRef="b_evgw" targetRef="b_c_ok"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f4" sourceRef="b_evgw" targetRef="b_c_no"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f5" sourceRef="b_c_ok" targetRef="b_send"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f6" sourceRef="b_send" targetRef="b_c_res"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f7" sourceRef="b_c_res" targetRef="b_end_ok"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f8" sourceRef="b_c_no" targetRef="b_end_no"></bpmn:sequenceFlow>
</bpmn:process>
<bpmn:process id="P_shop_proc" isExecutable="false">
<bpmn:laneSet id="P_shop_ls">
<bpmn:lane id="L_site" name="Сайт (система)">
<bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_reg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_restock</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_and2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_notify_full</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_end_full</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_notify_part</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_end_part</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_mgr" name="Менеджер магазину">
<bpmn:flowNodeRef>m_check</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gw</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_refuse</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_end_refuse</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_allow</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_wh" name="Склад">
<bpmn:flowNodeRef>w_c_goods</bpmn:flowNodeRef>
<bpmn:flowNodeRef>w_check</bpmn:flowNodeRef>
<bpmn:flowNodeRef>w_gw</bpmn:flowNodeRef>
<bpmn:flowNodeRef>w_and1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_acc" name="Бухгалтерія">
<bpmn:flowNodeRef>a_full</bpmn:flowNodeRef>
<bpmn:flowNodeRef>a_part</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:dataObject id="do_act_do" />
<bpmn:dataObjectReference id="do_act" name="Акт перевірки стану" dataObjectRef="do_act_do" />
<bpmn:dataStoreReference id="ds_stock" name="Залишки товарів" />
<bpmn:startEvent id="s_start" name="Отримано заявку"><bpmn:outgoing>g1</bpmn:outgoing><bpmn:messageEventDefinition id="ret_x4" /></bpmn:startEvent>
<bpmn:task id="s_reg" name="Зареєструвати заявку на повернення"><bpmn:incoming>g1</bpmn:incoming><bpmn:outgoing>g2</bpmn:outgoing></bpmn:task>
<bpmn:task id="m_check" name="Перевірити строк і підстави повернення"><bpmn:incoming>g2</bpmn:incoming><bpmn:outgoing>g3</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m_gw" name="Строк дотримано і підстави є?" default="g5"><bpmn:incoming>g3</bpmn:incoming><bpmn:outgoing>g4</bpmn:outgoing><bpmn:outgoing>g5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="m_refuse" name="Надіслати відмову з причиною"><bpmn:incoming>g5</bpmn:incoming><bpmn:outgoing>g6</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="m_end_refuse" name="Відмовлено"><bpmn:incoming>g6</bpmn:incoming></bpmn:endEvent>
<bpmn:sendTask id="m_allow" name="Надіслати дозвіл і адресу для повернення"><bpmn:incoming>g4</bpmn:incoming><bpmn:outgoing>g7</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="w_c_goods" name="Отримано товар"><bpmn:incoming>g7</bpmn:incoming><bpmn:outgoing>g8</bpmn:outgoing><bpmn:messageEventDefinition id="ret_x5" /></bpmn:intermediateCatchEvent>
<bpmn:task id="w_check" name="Перевірити комплектність і стан"><bpmn:incoming>g8</bpmn:incoming><bpmn:outgoing>g9</bpmn:outgoing><bpmn:dataOutputAssociation id="w_check_do_act_out"><bpmn:targetRef>do_act</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:multiInstanceLoopCharacteristics id="ret_x6" /></bpmn:task>
<bpmn:exclusiveGateway id="w_gw" name="Товар придатний?" default="g11"><bpmn:incoming>g9</bpmn:incoming><bpmn:outgoing>g10</bpmn:outgoing><bpmn:outgoing>g11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:parallelGateway id="w_and1" name=""><bpmn:incoming>g10</bpmn:incoming><bpmn:outgoing>g12</bpmn:outgoing><bpmn:outgoing>g13</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:task id="s_restock" name="Повернути одиницю на залишок"><bpmn:incoming>g12</bpmn:incoming><bpmn:outgoing>g14</bpmn:outgoing><bpmn:dataOutputAssociation id="s_restock_ds_stock_out"><bpmn:targetRef>ds_stock</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
<bpmn:subProcess id="a_full" name="Повернути повну суму"><bpmn:incoming>g13</bpmn:incoming><bpmn:outgoing>g15</bpmn:outgoing>
<bpmn:startEvent id="a_full_i0" name="Отримано акт перевірки"><bpmn:outgoing>a_full_f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="a_full_i1" name="Розрахувати суму за замовленням"><bpmn:incoming>a_full_f1</bpmn:incoming><bpmn:outgoing>a_full_f2</bpmn:outgoing></bpmn:task>
<bpmn:sequenceFlow id="a_full_f1" sourceRef="a_full_i0" targetRef="a_full_i1" />
<bpmn:task id="a_full_i2" name="Перерахувати кошти покупцю"><bpmn:incoming>a_full_f2</bpmn:incoming><bpmn:outgoing>a_full_f3</bpmn:outgoing></bpmn:task>
<bpmn:sequenceFlow id="a_full_f2" sourceRef="a_full_i1" targetRef="a_full_i2" />
<bpmn:endEvent id="a_full_i3" name="Кошти перераховано"><bpmn:incoming>a_full_f3</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="a_full_f3" sourceRef="a_full_i2" targetRef="a_full_i3" />
</bpmn:subProcess>
<bpmn:task id="a_part" name="Розрахувати і повернути частину коштів"><bpmn:incoming>g11</bpmn:incoming><bpmn:outgoing>g18</bpmn:outgoing></bpmn:task>
<bpmn:parallelGateway id="s_and2" name=""><bpmn:incoming>g14</bpmn:incoming><bpmn:incoming>g15</bpmn:incoming><bpmn:outgoing>g16</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:sendTask id="s_notify_full" name="Повідомити про повне повернення"><bpmn:incoming>g16</bpmn:incoming><bpmn:outgoing>g17</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="s_end_full" name="Кошти повернуто"><bpmn:incoming>g17</bpmn:incoming></bpmn:endEvent>
<bpmn:sendTask id="s_notify_part" name="Повідомити про часткове повернення"><bpmn:incoming>g18</bpmn:incoming><bpmn:outgoing>g19</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="s_end_part" name="Часткове повернення"><bpmn:incoming>g19</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="g1" sourceRef="s_start" targetRef="s_reg"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g2" sourceRef="s_reg" targetRef="m_check"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g3" sourceRef="m_check" targetRef="m_gw"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g4" name="так" sourceRef="m_gw" targetRef="m_allow"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">так</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g5" name="ні" sourceRef="m_gw" targetRef="m_refuse"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g6" sourceRef="m_refuse" targetRef="m_end_refuse"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g7" sourceRef="m_allow" targetRef="w_c_goods"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g8" sourceRef="w_c_goods" targetRef="w_check"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g9" sourceRef="w_check" targetRef="w_gw"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g10" name="так" sourceRef="w_gw" targetRef="w_and1"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">так</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g11" name="ні (пошкоджений)" sourceRef="w_gw" targetRef="a_part"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g12" sourceRef="w_and1" targetRef="s_restock"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g13" sourceRef="w_and1" targetRef="a_full"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g14" sourceRef="s_restock" targetRef="s_and2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g15" sourceRef="a_full" targetRef="s_and2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g16" sourceRef="s_and2" targetRef="s_notify_full"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g17" sourceRef="s_notify_full" targetRef="s_end_full"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g18" sourceRef="a_part" targetRef="s_notify_part"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="g19" sourceRef="s_notify_part" targetRef="s_end_part"></bpmn:sequenceFlow>
<bpmn:textAnnotation id="n1"><bpmn:text>Строк повернення — 14 днів від отримання замовлення</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="n1_as" sourceRef="m_check" targetRef="n1" />
<bpmn:textAnnotation id="n2"><bpmn:text>Сума — з урахуванням стану товару за актом перевірки</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="n2_as" sourceRef="a_part" targetRef="n2" />
</bpmn:process>
<bpmndi:BPMNDiagram id="ret_dia" name="02 Повернення товару"><bpmndi:BPMNPlane id="ret_plane" bpmnElement="ret_collab">
